# This file should be copies to .env and filled with the correct values 
# for your environment. The .env file should live in the same directory 
# as this file. 

# Onboard
# Allowed values: true, false
USE_STABLE=true
BRANCH_NAME=main # Branch to use
GIT_REPOSITORY=https://github.com/matthewlefler/devcade-onboard-ui-revamp # git repository to pull from

# Backend 
# Allowed log levels: trace, debug, info, warn, error 
RUST_LOG=warn #Logging level for the backend 
DEVCADE_API_DOMAIN=devcade.csh.rit.edu/api #URL for devcade API 
DEVCADE_DEV_API_DOMAIN=devcade-dev.csh.rit.edu/api #URL for devcade-dev API 

# Frontend 
# Allowed log levels: trace, verbose, debug, info, warn, error, fatal 
FRONTEND_LOG=warn # Logging level for the frontend 
LOG_LOCATION=/home/devcade/logs
# Amount of time in seconds until the screen saver is shown
SCREENSAVER_TIMEOUT_SEC=300
# Amount of time in seconds that the supervisor buttons need to be held
SUPERVISOR_BUTTON_TIMEOUT_SEC=5
# enable low performance mode, changes various features to be faster 
# on slower hardware
LOW_PERFORMANCE_MODE=false

# Demo mode will not display games with certain tags (e.g. "CSH Only") 
# Allowed values: true, false 
DEMO_MODE=false

# Shared 
# Games data and shared sockets will be placed here 
DEVCADE_PATH=/home/devcade/.devcade
