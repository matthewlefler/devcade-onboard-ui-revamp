# This file should be copies to .env and filled with the correct values
# for your environment. The .env file should live in the same directory
# as this file.

# Backend
# Allowed log levels: trace, debug, info, warn, error
RUST_LOG=debug #Logging level for the backend
DEVCADE_API_DOMAIN=localhost:8081/api #URL for devcade API 
DEVCADE_DEV_API_DOMAIN=localhost:8081/api #URL for devcade-dev API

# Frontend
# Allowed log levels: trace, verbose, debug, info, warn, error, fatal
FRONTEND_LOG=debug # Logging level for the frontend
LOG_LOCATION=/var/home/devcade/.devcade/logs
VIEW_WIDTH= 
VIEW_HEIGHT=
# Amount of time in seconds until the screen saver is shown
SCREENSAVER_TIMEOUT_SEC=300
# Amount of time in seconds that the supervisor
SUPERVISOR_BUTTON_TIMEOUT_SEC=5

# Demo mode will not display games with certain tags (e.g. "CSH Only")
# Allowed values: true, false
DEMO_MODE=false

# Shared
# Games data and shared sockets will be placed here
DEVCADE_PATH=/var/home/devcade/.devcade
Y_SCALE_INSTRUCTIONS=
Y_SCALE_DESC=